# Copy this file to .env.local for local dev, and add the same keys under
# Vercel → Project → Settings → Environment Variables for production/preview.

# Your deployed URL — used for SEO (canonical URLs, sitemap.xml, Open Graph
# tags). Defaults to http://localhost:3000 if unset. Set this to your real
# domain once deployed. Server-only (read in metadata/robots/sitemap, never
# in browser JS), so it deliberately does NOT use the NEXT_PUBLIC_ prefix —
# unlike the three below, which must keep that prefix (see their comment).
NEXT_SITE_URL=

# Mapbox — used for the route map on /flights. https://account.mapbox.com/access-tokens
# NEXT_PUBLIC_ is required here, not optional — this is read in a client
# component (the map), and Next.js only ships env vars to the browser when
# they're prefixed exactly NEXT_PUBLIC_. Renaming it breaks the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase — Project Settings > API. Same NEXT_PUBLIC_ requirement as above:
# the anon key is read in client components (auth, wallet), so it must keep
# the prefix to reach the browser. It's still safe to expose — RLS policies
# in supabase/schema.sql do the real access control, not secrecy of this
# key. Never expose the service role key client-side (and note it has no
# NEXT_PUBLIC_ prefix precisely because it must never reach the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — sends every transactional email (booking confirmations, receipts,
# gift cards, welcome, contact replies). Free tier, no domain needed to
# start: sign up at https://resend.com, an API key is created for you
# automatically. Without a verified domain you can only send to the email
# address you signed up with — good enough to test the whole flow end to
# end. Also gated behind the "Email notifications" toggle in
# /admin/settings — both need to be on for anything to actually send.
RESEND_API_KEY=
# Optional. Defaults to AirFly <onboarding@resend.dev> (Resend's shared
# sandbox address) until you verify your own domain in Resend.
EMAIL_FROM=
